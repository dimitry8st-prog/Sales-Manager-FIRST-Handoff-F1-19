diff --git a/sales_handoff_intent.py b/sales_handoff_intent.py
new file mode 100644
index 0000000..990e697
--- /dev/null
+++ b/sales_handoff_intent.py
@@ -0,0 +1,151 @@
+"""Подготовка передачи клиента менеджеру без внешних действий."""
+
+from sales_first_handoff import assemble_handoff_context
+
+
+class HandoffIntentError(ValueError):
+    """Ошибка подготовки передачи с публичным кодом."""
+
+    def __init__(self, code: str):
+        self.code = code
+        super().__init__(code)
+
+# Точные наборы обязательных полей двух новых входов.
+_RECIPIENT_FIELDS = frozenset((
+    "schema_version",
+    "client_id",
+    "runtime_campaign_id",
+    "recipient_ref",
+    "approval_ref",
+))
+
+_INTEREST_FIELDS = frozenset((
+    "schema_version",
+    "client_id",
+    "runtime_campaign_id",
+    "lead_id",
+    "decision",
+    "evidence_ref",
+))
+
+
+def _check_fields(value, expected_fields):
+    """Проверить тип словаря и точный набор его полей."""
+    if type(value) is not dict:
+        raise HandoffIntentError("INVALID_INPUT")
+
+    if value.keys() != expected_fields:
+        raise HandoffIntentError("INVALID_INPUT")
+
+
+def _check_id(value):
+    """Проверить ID без исправления или усечения."""
+    if type(value) is not str:
+        raise HandoffIntentError("INVALID_INPUT")
+
+    if not 1 <= len(value) <= 128:
+        raise HandoffIntentError("INVALID_INPUT")
+
+    if value != value.strip():
+        raise HandoffIntentError("INVALID_INPUT")
+
+    if any(ord(char) < 32 or ord(char) == 127 for char in value):
+        raise HandoffIntentError("INVALID_INPUT")
+
+    try:
+        value.encode("utf-8")
+    except UnicodeEncodeError:
+        raise HandoffIntentError("INVALID_INPUT") from None
+
+def build_handoff_intent(
+    context: dict,
+    recipient: dict,
+    interest: dict,
+) -> dict:
+    """Проверить входы и подготовить решение о передаче."""
+
+    # 1. Проверяем тип контекста и структуры новых входов.
+    if type(context) is not dict:
+        raise HandoffIntentError("INVALID_INPUT")
+
+    _check_fields(recipient, _RECIPIENT_FIELDS)
+    _check_fields(interest, _INTEREST_FIELDS)
+
+    # 2. Проверяем точные версии двух новых структур.
+    if (
+        type(recipient["schema_version"]) is not str
+        or recipient["schema_version"] != "FIRST_HANDOFF_RECIPIENT_V1"
+    ):
+        raise HandoffIntentError("INVALID_INPUT")
+
+    if (
+        type(interest["schema_version"]) is not str
+        or interest["schema_version"] != "FIRST_INTEREST_EVIDENCE_V1"
+    ):
+        raise HandoffIntentError("INVALID_INPUT")
+
+    # 3. Проверяем идентификаторы получателя и свидетельства.
+    for field in (
+        "client_id",
+        "runtime_campaign_id",
+        "recipient_ref",
+        "approval_ref",
+    ):
+        _check_id(recipient[field])
+
+    for field in (
+        "client_id",
+        "runtime_campaign_id",
+        "lead_id",
+        "evidence_ref",
+    ):
+        _check_id(interest[field])
+
+    decision = interest["decision"]
+    if (
+        type(decision) is not str
+        or decision not in ("INTEREST", "QUESTION", "UNCERTAIN")
+    ):
+        raise HandoffIntentError("INVALID_INPUT")
+
+    # 4. Получатель и свидетельство должны относиться
+    # к одному клиенту и одной кампании.
+    for field in ("client_id", "runtime_campaign_id"):
+        if recipient[field] != interest[field]:
+            raise HandoffIntentError("SCOPE_MISMATCH")
+
+    # Проверяем имеющиеся строковые поля области контекста.
+    # Отсутствующие или неверно типизированные поля затем
+    # отклонит принятый валидатор F1-09.
+    for field in ("client_id", "runtime_campaign_id", "lead_id"):
+        if type(context.get(field)) is str:
+            if context[field] != interest[field]:
+                raise HandoffIntentError("SCOPE_MISMATCH")
+
+    # 5. F1-09 проверяет полный контекст и собирает копию.
+    # Его ошибки передаются вызывающей программе без замены.
+    assembled = assemble_handoff_context(context)
+
+    # 6. Валидные данные без подтверждённого интереса:
+    # передача не подготавливается.
+    if decision != "INTEREST":
+        return {
+            "schema_version": "FIRST_HANDOFF_INTENT_V1",
+            "status": "HOLD",
+            "handoff_id": None,
+            "content_sha256": None,
+            "recipient_ref": None,
+            "context": None,
+            "code": "INTEREST_NOT_CONFIRMED",
+        }
+
+    # 7. Интерес подтверждён, контекст проверен.
+    return {
+        "schema_version": "FIRST_HANDOFF_INTENT_V1",
+        "status": "PREPARED",
+        "handoff_id": assembled["handoff_id"],
+        "content_sha256": assembled["content_sha256"],
+        "recipient_ref": recipient["recipient_ref"],
+        "context": assembled,
+        "code": "OK",
+    }
\ No newline at end of file
diff --git a/tests/wave3/test_f119.py b/tests/wave3/test_f119.py
new file mode 100644
index 0000000..d51293d
--- /dev/null
+++ b/tests/wave3/test_f119.py
@@ -0,0 +1,336 @@
+import json
+import unittest
+from copy import deepcopy
+from pathlib import Path
+
+from sales_first_handoff import HandoffContextError
+from sales_handoff_intent import (
+    HandoffIntentError,
+    build_handoff_intent,
+)
+
+
+# Пример хранится внутри source и переносится вместе с тестами.
+EXAMPLE_PATH = (
+    Path(__file__).resolve().parents[1]
+    / "fixtures"
+    / "wave3"
+    / "f119"
+    / "examples.json"
+)
+
+
+class HandoffIntentTests(unittest.TestCase):
+    def setUp(self):
+        # Каждый тест получает свежие данные из примера ТЗ.
+        example = json.loads(
+            EXAMPLE_PATH.read_text(
+                encoding="utf-8"
+            )
+        )
+        self.inputs = example["input"]
+        self.expected = example["expected"]
+
+    def test_interest_matches_exact_example(self):
+        actual = build_handoff_intent(**self.inputs)
+        self.assertEqual(actual, self.expected)
+
+    def test_question_and_uncertain_hold(self):
+        for decision in ("QUESTION", "UNCERTAIN"):
+            with self.subTest(decision=decision):
+                inputs = deepcopy(self.inputs)
+                inputs["interest"]["decision"] = decision
+
+                actual = build_handoff_intent(**inputs)
+
+                self.assertEqual(actual, {
+                    "schema_version": "FIRST_HANDOFF_INTENT_V1",
+                    "status": "HOLD",
+                    "handoff_id": None,
+                    "content_sha256": None,
+                    "recipient_ref": None,
+                    "context": None,
+                    "code": "INTEREST_NOT_CONFIRMED",
+                })
+
+    def test_prepared_context_is_not_dispatched(self):
+        actual = build_handoff_intent(**self.inputs)
+        self.assertEqual(
+            actual["context"]["delivery_status"],
+            "NOT_DISPATCHED",
+        )
+    def test_foreign_recipient_scope_rejected(self):
+        for field in ("client_id", "runtime_campaign_id"):
+            with self.subTest(field=field):
+                inputs = deepcopy(self.inputs)
+                inputs["recipient"][field] = "foreign"
+
+                with self.assertRaises(HandoffIntentError) as caught:
+                    build_handoff_intent(**inputs)
+
+                self.assertEqual(
+                    caught.exception.code, "SCOPE_MISMATCH"
+                )
+                self.assertEqual(
+                    str(caught.exception), "SCOPE_MISMATCH"
+                )
+
+    def test_foreign_interest_scope_rejected(self):
+        for field in ("client_id", "runtime_campaign_id", "lead_id"):
+            with self.subTest(field=field):
+                inputs = deepcopy(self.inputs)
+                inputs["interest"][field] = "foreign"
+
+                with self.assertRaises(HandoffIntentError) as caught:
+                    build_handoff_intent(**inputs)
+
+                self.assertEqual(
+                    caught.exception.code, "SCOPE_MISMATCH"
+                )
+                self.assertEqual(
+                    str(caught.exception), "SCOPE_MISMATCH"
+                )
+    def test_missing_history_rejected(self):
+        inputs = deepcopy(self.inputs)
+        del inputs["context"]["history"]
+
+        with self.assertRaises(HandoffContextError) as caught:
+            build_handoff_intent(**inputs)
+
+        self.assertEqual(
+            caught.exception.code, "INVALID_CONTEXT"
+        )
+        self.assertEqual(
+            str(caught.exception), "INVALID_CONTEXT"
+        )
+
+    def test_history_over_limit_rejected_without_changes(self):
+        inputs = deepcopy(self.inputs)
+        original_message = inputs["context"]["history"][0]
+
+        history = []
+        for number in range(101):
+            message = deepcopy(original_message)
+            message["message_id"] = f"message-{number}"
+            message["sequence"] = number
+            history.append(message)
+
+        inputs["context"]["history"] = history
+        before = deepcopy(inputs)
+
+        with self.assertRaises(HandoffContextError) as caught:
+            build_handoff_intent(**inputs)
+
+        self.assertEqual(
+            caught.exception.code, "INVALID_CONTEXT"
+        )
+        self.assertEqual(inputs, before)
+
+    def test_long_recipient_and_interest_ids_rejected(self):
+        fields_by_input = {
+            "recipient": (
+                "client_id",
+                "runtime_campaign_id",
+                "recipient_ref",
+                "approval_ref",
+            ),
+            "interest": (
+                "client_id",
+                "runtime_campaign_id",
+                "lead_id",
+                "evidence_ref",
+            ),
+        }
+
+        for input_name, fields in fields_by_input.items():
+            for field in fields:
+                with self.subTest(input=input_name, field=field):
+                    inputs = deepcopy(self.inputs)
+                    inputs[input_name][field] = "x" * 129
+                    before = deepcopy(inputs)
+
+                    with self.assertRaises(HandoffIntentError) as caught:
+                        build_handoff_intent(**inputs)
+
+                    self.assertEqual(
+                        caught.exception.code, "INVALID_INPUT"
+                    )
+                    self.assertEqual(inputs, before)
+
+    def test_long_context_event_id_rejected(self):
+        inputs = deepcopy(self.inputs)
+        inputs["context"]["handoff_event_id"] = "x" * 129
+        before = deepcopy(inputs)
+
+        with self.assertRaises(HandoffContextError) as caught:
+            build_handoff_intent(**inputs)
+
+        self.assertEqual(
+            caught.exception.code, "INVALID_CONTEXT"
+        )
+        self.assertEqual(inputs, before)
+
+    def test_changed_body_changes_hash_with_same_handoff_id(self):
+        original = build_handoff_intent(**self.inputs)
+
+        changed_inputs = deepcopy(self.inputs)
+        changed_inputs["context"]["history"][0]["body"] = (
+            "Другой синтетический текст сообщения."
+        )
+        changed = build_handoff_intent(**changed_inputs)
+
+        self.assertEqual(
+            original["handoff_id"], changed["handoff_id"]
+        )
+        self.assertNotEqual(
+            original["content_sha256"],
+            changed["content_sha256"],
+        )
+        self.assertEqual(
+            changed["context"]["history"][0]["body"],
+            changed_inputs["context"]["history"][0]["body"],
+        )
+
+    def test_input_unchanged_and_result_detached(self):
+        before = deepcopy(self.inputs)
+        actual = build_handoff_intent(**self.inputs)
+
+        # Сам вызов не должен менять вход.
+        self.assertEqual(self.inputs, before)
+
+        # Меняем вложенные объекты результата.
+        actual["context"]["history"][0]["body"] = "Изменено"
+        actual["context"]["history"][0]["fact_ids"].append(
+            "result-only"
+        )
+        actual["context"]["language_packs"]["ru-RU"] = "changed"
+        actual["context"]["history"].clear()
+
+        # Исходные данные должны остаться прежними.
+        self.assertEqual(self.inputs, before)
+
+    def test_missing_and_extra_fields_rejected(self):
+        for input_name in ("recipient", "interest"):
+            for field in self.inputs[input_name]:
+                with self.subTest(input=input_name, missing=field):
+                    inputs = deepcopy(self.inputs)
+                    del inputs[input_name][field]
+
+                    with self.assertRaises(HandoffIntentError) as caught:
+                        build_handoff_intent(**inputs)
+
+                    self.assertEqual(
+                        caught.exception.code, "INVALID_INPUT"
+                    )
+
+            with self.subTest(input=input_name, extra=True):
+                inputs = deepcopy(self.inputs)
+                inputs[input_name]["unexpected"] = "extra"
+
+                with self.assertRaises(HandoffIntentError) as caught:
+                    build_handoff_intent(**inputs)
+
+                self.assertEqual(
+                    caught.exception.code, "INVALID_INPUT"
+                )
+
+    def test_wrong_types_versions_and_decisions_rejected(self):
+        for input_name in ("context", "recipient", "interest"):
+            for invalid in (None, [], "text", 1, True):
+                with self.subTest(input=input_name, value=invalid):
+                    inputs = deepcopy(self.inputs)
+                    inputs[input_name] = invalid
+
+                    with self.assertRaises(HandoffIntentError) as caught:
+                        build_handoff_intent(**inputs)
+
+                    self.assertEqual(
+                        caught.exception.code, "INVALID_INPUT"
+                    )
+
+        for input_name in ("recipient", "interest"):
+            for field in self.inputs[input_name]:
+                with self.subTest(input=input_name, field=field):
+                    inputs = deepcopy(self.inputs)
+                    inputs[input_name][field] = []
+
+                    with self.assertRaises(HandoffIntentError) as caught:
+                        build_handoff_intent(**inputs)
+
+                    self.assertEqual(
+                        caught.exception.code, "INVALID_INPUT"
+                    )
+
+            inputs = deepcopy(self.inputs)
+            inputs[input_name]["schema_version"] = "WRONG_VERSION"
+
+            with self.assertRaises(HandoffIntentError) as caught:
+                build_handoff_intent(**inputs)
+
+            self.assertEqual(
+                caught.exception.code, "INVALID_INPUT"
+            )
+
+        for invalid in ("UNKNOWN", "interest", ""):
+            with self.subTest(decision=invalid):
+                inputs = deepcopy(self.inputs)
+                inputs["interest"]["decision"] = invalid
+
+                with self.assertRaises(HandoffIntentError) as caught:
+                    build_handoff_intent(**inputs)
+
+                self.assertEqual(
+                    caught.exception.code, "INVALID_INPUT"
+                )
+
+    def test_error_precedence(self):
+        inputs = deepcopy(self.inputs)
+
+        # Три дефекта одновременно.
+        inputs["recipient"]["recipient_ref"] = []
+        inputs["interest"]["lead_id"] = "foreign"
+        del inputs["context"]["history"]
+
+        # Неверный тип имеет первый приоритет.
+        with self.assertRaises(HandoffIntentError) as caught:
+            build_handoff_intent(**inputs)
+
+        self.assertEqual(
+            caught.exception.code, "INVALID_INPUT"
+        )
+
+        # Исправляем тип: теперь обнаруживается чужой лид.
+        inputs["recipient"]["recipient_ref"] = "owner-test"
+
+        with self.assertRaises(HandoffIntentError) as caught:
+            build_handoff_intent(**inputs)
+
+        self.assertEqual(
+            caught.exception.code, "SCOPE_MISMATCH"
+        )
+
+        # Исправляем лида: остаётся ошибка контекста F1-09.
+        inputs["interest"]["lead_id"] = (
+            self.inputs["interest"]["lead_id"]
+        )
+
+        with self.assertRaises(HandoffContextError) as caught:
+            build_handoff_intent(**inputs)
+
+        self.assertEqual(
+            caught.exception.code, "INVALID_CONTEXT"
+        )
+
+    def test_invalid_context_not_hidden_by_hold(self):
+        for decision in ("QUESTION", "UNCERTAIN"):
+            with self.subTest(decision=decision):
+                inputs = deepcopy(self.inputs)
+                inputs["interest"]["decision"] = decision
+                del inputs["context"]["history"]
+
+                with self.assertRaises(HandoffContextError) as caught:
+                    build_handoff_intent(**inputs)
+
+                self.assertEqual(
+                    caught.exception.code, "INVALID_CONTEXT"
+                )
